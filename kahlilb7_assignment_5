# ========================================
# Step 1: Collatz Sequence 
# ========================================

start_number = int(input("Enter starting number: "))

current = start_number
steps = 0

print("Sequence:", current, end=" ")

while current != 1:
    if current % 2 == 0:
        current = current // 2
    else:
        current = 3 * current + 1

    print(current, end=" ")
    steps += 1

print()
print("Steps:", steps)